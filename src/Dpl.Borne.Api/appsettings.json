      "LogLevel": { "Default": "Warning" }
    }
  },
  "AllowedHosts": "*",

  "Donnees": {
    "Source": "Demo",
    "DelaiSecondes": 15
  },

  "ConnectionStrings": {
    "LoadAndGo": ""
  },

